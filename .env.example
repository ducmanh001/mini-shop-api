NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
PUBLIC_WEB_URL=http://localhost:3001
APP_TIMEZONE=Asia/Bangkok
# Local disk folder for uploaded product images, relative to the repo root (already gitignored).
UPLOAD_DIR=storage/uploads

# PostgreSQL
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=mini_shop
DB_PASSWORD=mini_shop
DB_NAME=mini_shop

# Redis — local (docker-compose) không cần auth. Managed Redis (Railway...) bắt buộc REDIS_PASSWORD.
REDIS_HOST=localhost
REDIS_PORT=6381
# REDIS_PASSWORD=

# Authentication
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=86400

# Local SMTP (Mailpit) — không cần auth. Trên cloud, trỏ sang SMTP thật (vd Mailtrap sandbox) và
# set thêm MAIL_USER/MAIL_PASSWORD (bắt buộc đi cùng nhau) + MAIL_SECURE=true nếu provider dùng
# cổng 465 (SSL trực tiếp thay vì STARTTLS trên 587).
MAIL_HOST=localhost
MAIL_PORT=1026
MAIL_FROM=no-reply@mini-shop.example.com
# MAIL_USER=
# MAIL_PASSWORD=
MAIL_SECURE=false
# Nhiều PaaS (Railway...) chặn outbound SMTP — có giá trị này thì dùng Mailtrap Email Testing
# (Sandbox) API (HTTP, cổng 443) thay vì SMTP ở trên; bỏ trống thì vẫn dùng SMTP (local/CI/Mailpit
# không đổi). Bắt buộc đi cùng MAILTRAP_INBOX_ID (lấy trong URL inbox trên Mailtrap dashboard) —
# dùng nhầm Sending API (send.api.mailtrap.io) với tài khoản sandbox sẽ bị 401 dù token đủ quyền.
# MAIL_API_TOKEN=
# MAILTRAP_INBOX_ID=

# Base64 of 32 raw bytes (AES-256 key) for email_notifications.secret_ciphertext. Generate your
# own — do NOT reuse the placeholder below, app fails fast at boot if the length is wrong:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NOTIFICATION_SECRET_KEY=replace-with-output-of-the-command-above

# Reverse proxy: number of trusted proxies in front of the app (Railway/nginx/ALB = 1). Keep 0 when
# the app is exposed directly. Wrong value behind a proxy makes every client share one IP, so the
# per-IP rate limit below turns into a limit for ALL users; a value that is too high lets clients
# spoof X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Rate limit for the public auth endpoints (register, verify-email, login, forgot-password,
# reset-password). Counted in Redis, per route, both per client IP and per email in the body.
# Defaults are production-safe; raise them locally if manual testing keeps tripping 429.
THROTTLE_AUTH_IP_LIMIT=20
THROTTLE_AUTH_IP_TTL_SECONDS=60
THROTTLE_AUTH_ACCOUNT_LIMIT=10
THROTTLE_AUTH_ACCOUNT_TTL_SECONDS=900
